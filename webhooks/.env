# Configuration du serveur
PORT=3000
NODE_ENV=development

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/pi-superapp

# Pi Network
PI_API_KEY=votre_api_key_pi
PI_WEBHOOK_SECRET=votre_webhook_secret
PI_APP_SECRET=votre_app_secret

# JWT
JWT_SECRET=votre_jwt_secret_super_securise

# Cloudinary (pour les fichiers)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Email (optionnel)
EMAIL_SERVICE=gmail
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_app

# Configuration de l'application
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Taux de change (exemple)
EXCHANGE_RATE=0.01