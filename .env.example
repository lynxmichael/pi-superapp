PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/pi-superapp

# Longue chaîne aléatoire (obligatoire)
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire

# --- Pi Network (portail développeur : develop.pi dans le Pi Browser) ---
# true pour tester dans le bac à sable Pi (sandbox.minepi.com), false en production
PI_SANDBOX=true
# Clé API serveur de l'app
PI_API_KEY=votre_cle_api_pi
# Seed privée du wallet de l'app (commence par S, 56 caractères) : sert à envoyer les retraits.
# Ne la partagez jamais et ne la mettez jamais dans Git.
PI_WALLET_PRIVATE_SEED=S_votre_seed_privee

# --- Règles de dépôt / retrait (en Pi) ---
MIN_DEPOSIT=0.01
MIN_WITHDRAWAL=1
# Frais retenus sur chaque retrait (le réseau Pi facture 0,01 π par envoi au wallet de l'app)
WITHDRAWAL_FEE=0.01

# --- Administration ---
# Noms d'utilisateur Pi qui deviennent admin en se connectant avec Pi (séparés par des virgules)
ADMIN_PI_USERNAMES=
# Code secret pour créer un compte admin avec PIN sur /admin/auth (connexion depuis un ordinateur)
ADMIN_REGISTRATION_CODE=

# Anciens services (marketplace, jeux, recharge, KYC...) : laisser à false.
# Leur ancienne connexion ne demande pas de mot de passe.
ENABLE_LEGACY_SERVICES=false

# Utilisés seulement par les anciens services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
